# ==============================================================================
# Ruijie Fleet & Config Generator - Environment Configuration
# ==============================================================================

# Web & API Server
PORT=3001
JWT_SECRET=super_secret_jwt_key_change_me
DISABLE_AUTH=false

# Google OAuth (Optional - enabled when DISABLE_AUTH=false)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
ALLOWED_EMAILS=user1@gmail.com,user2@gmail.com

# PostgreSQL Database
DATABASE_URL=postgresql://ruijie:ruijiepass@localhost:5432/ruijiedb

# Redis Cache (Real-time telemetry & port states)
REDIS_URL=redis://localhost:6379

# InfluxDB (Optical DDM time-series metrics)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=ruijie-secret-fleet-token-12345
INFLUX_ORG=ruijie_fleet
INFLUX_BUCKET=switch_metrics

# gRPC Dial-Out Telemetry & Collector
# IP and Port of this collector server reachable from your network switch mgmt/vlan
GRPC_COLLECTOR_IP=10.23.9.10
GRPC_COLLECTOR_PORT=50051
GRPC_PORT=50051
GNMIC_PATH=/usr/local/bin/gnmic
