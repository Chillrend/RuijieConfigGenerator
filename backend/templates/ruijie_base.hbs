!
hostname {{hostname}}
!
{{#if timezone}}
clock timezone {{timezone}}
!
{{/if}}
{{#if ntpServers}}
{{#each ntpServers}}
ntp server {{this}}
{{/each}}
!
{{/if}}
{{#if enableWeb}}
enable service web-server
enable service web-server http
enable service web-server https
!
{{/if}}
{{#if enableSsh}}
enable service ssh-server
line vty 0 4
 login local
 transport input ssh
!
{{/if}}
{{#if enablePassword}}
enable secret {{enablePassword}}
!
{{/if}}
{{#if adminUsername}}
username {{adminUsername}} password 0 {{adminPassword}}
{{#if enableWeb}}
webmaster level 0 username {{adminUsername}} password 0 {{adminPassword}}
{{/if}}
!
{{/if}}
{{#if enableCwmp}}
cwmp
 acs url https://wiscloud-as.ruijienetworks.com/acs
 cpe inform interval 60
 timer cpe-timeout 70
!
{{/if}}
{{#each vlans}}
vlan {{this.id}}
 name {{this.name}}
!
{{/each}}
interface vlan 1
 no ip address
!
{{#if mgmtVlan}}
interface vlan {{mgmtVlan}}
 ip address {{mgmtIp}} {{mgmtMask}}
!
ip route 0.0.0.0 0.0.0.0 {{mgmtGateway}}
!
{{/if}}
{{#each ports}}
interface {{this.mappedName}}
{{#if this.description}}
 description {{this.description}}
{{/if}}
 switchport mode {{this.mode}}
{{#if (eq this.mode "access")}}
 switchport access vlan {{this.vlan}}
{{else}}
 switchport trunk allowed vlan {{this.allowed_vlans}}
{{#if this.native_vlan}}
 switchport trunk native vlan {{this.native_vlan}}
{{/if}}
{{/if}}
{{#if (eq this.poeMode "disabled")}}
 no poe enable
{{/if}}
{{#if (eq this.poeMode "enabled")}}
 poe enable
{{#if this.poePriority}}
{{#unless (eq this.poePriority "default")}}
 poe priority {{this.poePriority}}
{{/unless}}
{{/if}}
{{#if this.poeMaxPower}}
 poe max-power {{this.poeMaxPower}}
{{/if}}
{{/if}}
!
{{/each}}
