PORT=3001
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
JWT_SECRET=super_secret_jwt_key_change_me
ALLOWED_EMAILS=user1@gmail.com,user2@gmail.com

# For development only! Set this to your Vite URL (e.g. https://localhost:5173 or http://localhost:5173). 
# If empty, the app will use relative paths suitable for Docker production.
FRONTEND_URL=

# Bypass auth for local dev (will be ignored in NODE_ENV=production)
DISABLE_AUTH=false

# Fleet Management Infrastructure
DATABASE_URL=postgresql://ruijie:ruijiepass@localhost:5432/ruijiedb
REDIS_URL=redis://localhost:6379
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=ruijie-secret-fleet-token-12345
INFLUX_ORG=ruijie_fleet
INFLUX_BUCKET=switch_metrics

